# Copy to .env; never commit local credentials.
# Local development only. Non-local deployment needs a unique secret.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# MySQL: create an empty utf8mb4 database and a dedicated local user first.
DB_NAME=agri_db
DB_USER=agri_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional services; leave blank to use local processing / offline overview.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TIANDITU_API_KEY=
MAP_CLIENT_ORIGIN=http://127.0.0.1:5173/
DEVICE_INGEST_TOKEN=

# Google Earth Engine
# Required: set your GEE cloud project id
GEE_PROJECT=

# Optional (service account mode)
# If you do not set these, the code falls back to local `earthengine authenticate`.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
